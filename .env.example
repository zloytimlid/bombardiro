APP_NAME="Lil Critter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Порт nginx на хосте (docker compose)
APP_PORT=8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

# Пароли — argon2id (раздел 13)
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (сервис postgres в compose.yaml)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=b25j
DB_USERNAME=b25j
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=b25j_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit: веб-интерфейс http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="crew@lil-critter.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-совместимое хранилище: SeaweedFS в dev (ADR-0003)
AWS_ACCESS_KEY_ID=b25j-dev
AWS_SECRET_ACCESS_KEY=b25j-dev-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=b25j
AWS_ENDPOINT=http://s3:9000
AWS_URL=http://localhost:9000/b25j
AWS_USE_PATH_STYLE_ENDPOINT=true

# Laravel Reverb. Сервер слушает 8080 внутри контейнера,
# браузер ходит через nginx: ws://localhost:8000/app
REVERB_APP_ID=b25j
REVERB_APP_KEY=b25j-local-key
REVERB_APP_SECRET=b25j-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8000
VITE_REVERB_SCHEME=http

# Учётная запись администратора, которую создаёт DatabaseSeeder (только для dev)
SEED_ADMIN_EMAIL=admin@lil-critter.test
SEED_ADMIN_PASSWORD=

# /admin требует подтверждённую 2FA (раздел 13)
ADMIN_REQUIRE_2FA=true

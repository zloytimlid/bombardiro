        "@sentry/vue": "^10.78.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "comlink": "^4.4.2",
        "laravel-echo": "^2.6.3",
        "laravel-vite-plugin": "^3.0.0",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",

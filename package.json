{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "vue-tsc --noEmit",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "test:js": "vitest run",
        "test:e2e": "playwright test",
        "schemas:generate": "vitest run resources/js/sim/core/schemas.test.ts -u",
        "budget:bundle": "node scripts/check-bundle-budget.mjs"
    },

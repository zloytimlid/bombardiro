        "@vitest/coverage-v8": "^5.0.5",
        "concurrently": "^10.0.3",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.14.0",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.72.1",
